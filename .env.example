# ── Database (Neon) ─────────────────────────────────────────────
# Pooled connection string, used by the app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/sonocbt?sslmode=require"
# Direct (non-pooled) connection string, used by migrations and the seed.
# Neon's own name for it, DATABASE_URL_UNPOOLED, also works.
DATABASE_URL_DIRECT="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/sonocbt?sslmode=require"
# Local development without Neon: an embedded Postgres stored in ./.pglite
# DATABASE_URL="pglite:./.pglite"

# ── Auth (Better Auth) ──────────────────────────────────────────
# Generate with: npx @better-auth/cli secret   (or any 32+ random characters)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# ── Email — optional in development; emails are logged to the console when unset ─
# Brevo (free, 300/day): create an API key at app.brevo.com → SMTP & API → API keys,
# and verify your sender address under Senders (a Gmail address is fine — no domain needed).
BREVO_API_KEY=""
# Must be the verified Brevo sender. The name part is what recipients see.
EMAIL_FROM="SonoCBT <you@gmail.com>"
# Alternative once you own a domain: Resend (used only if BREVO_API_KEY is empty).
RESEND_API_KEY=""

# ── App ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Signs short-lived parent result-view tokens.
RESULTS_TOKEN_SECRET=""

# ── File storage (Cloudflare R2, S3 API) — optional in development ─
# Without these, uploads are saved to ./.uploads and served at /files/… (dev only).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="sonocbt"
# Public URL of the bucket (r2.dev subdomain or a custom domain), no trailing slash.
R2_PUBLIC_URL=""
# A second, private bucket for exam identity photos (never public). Needed to use webcam snapshots in production.
R2_PRIVATE_BUCKET=""

# ── AI (Google Gemini) — photo import, "Write with AI", topic suggestions ─
# Create a key at https://aistudio.google.com/apikey. Only question text and lesson notes are sent.
GEMINI_API_KEY=""
# Optional: models to try, in order, comma-separated. If one is busy or out of free quota the next is used.
# Default: gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_MODEL=""
# Optional: AI requests per school per 24 hours (default 60).
AI_DAILY_LIMIT=""

# ── Seed / tests ─
# Optional: SEED_EXAM_OPEN=1 makes `npm run db:seed` open JSS3 Mock · Paper 1 straight away (npm run dev:e2e sets it for you).
# NEXT_DIST_DIR: build folder (default .next); the end-to-end server uses its own.

# ─── Payments (Paystack, test mode) ──────────────────────────────────────────
# A sk_test_ secret key from the Paystack dashboard (Settings → API keys).
# Set the webhook URL there to https://<your domain>/api/paystack/webhook.
PAYSTACK_SECRET_KEY=""
# Development without keys: "1" sends checkouts to an in-app stand-in
# (/dev/paystack-checkout). Ignored when a sk_live_ key is set. Never in production.
PAYSTACK_MOCK=""

# ─── Demo school & marketing ─────────────────────────────────────────────────
# One-click demo sign-in on /demo. On by default in development; in production
# it's off unless set to "1". The demo school (Crestview) is rebuilt nightly.
DEMO_MODE=""
# Vercel sends this as "Authorization: Bearer …" to /api/cron/reset-demo (see vercel.json).
CRON_SECRET=""
# "Book a demo" WhatsApp number in international format without +, e.g. 2348012345678.
NEXT_PUBLIC_SALES_WHATSAPP=""
